# All variables are optional; unset variables use the defaults noted in each file.

# --- auth (scripts/_env.sh) ---
# LiteLLM master key. If unset, a random key is generated once into .run/master.key (chmod 600).
LITELLM_MASTER_KEY=
# Codex auth file read by scripts/real-up.sh (default ~/.codex/auth.json)
CODEX_AUTH_FILE=

# --- bridge (litellm/pii_bridge.py) ---
PII_BRIDGE_PALENA_URL=
PII_BRIDGE_PALENA_API_KEY=
PII_BRIDGE_REDIS_URL=
PII_BRIDGE_REDIS_PREFIX=
PII_BRIDGE_CACHE=
PII_BRIDGE_SYSTEM_PATTERN_ONLY=
PII_BRIDGE_LEAK_ACTION=
PII_BRIDGE_METRICS_PORT=
PII_BRIDGE_METRICS_ADDR=
PII_BRIDGE_NO_RESTORE=
PII_BRIDGE_TIMEOUT=

# --- audit (litellm/pii_audit.py) ---
PII_AUDIT_LOG=
PII_AUDIT_KEY=
PII_AUDIT_REQUIRED=

# --- Palena (scripts/_env.sh) ---
PALENA_PSEUDONYMIZER_LOG_LEVEL=
PALENA_PSEUDONYMIZER_REDIS_SESSION_TTL_SECONDS=
PALENA_PSEUDONYMIZER_PRESIDIO_LANGUAGES=
PALENA_PSEUDONYMIZER_PRESIDIO_ENTITIES=
PALENA_PSEUDONYMIZER_ENTITY_STRATEGY=
PALENA_PSEUDONYMIZER_NO_RESTORE_ENTITIES=
PALENA_PSEUDONYMIZER_ALLOWLIST_FILE=
PALENA_PSEUDONYMIZER_COMMON_WORDS_FILE=

# --- demo (demo/server.py) ---
DEMO_LITELLM_MOCK=
DEMO_LITELLM_REAL=
DEMO_MODEL_MOCK=
DEMO_MODEL_REAL=
DEMO_UPSTREAM_MOCK=
DEMO_REDIS_HOST=
DEMO_REDIS_PORT=
